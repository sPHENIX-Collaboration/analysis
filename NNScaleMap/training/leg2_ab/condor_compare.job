# leg2_ab/compare.py on the finished A/B runs (DAG child of condor_leg2_ab.job)
base               = /sphenix/user/hjheng/sPHENIXRepo/analysis/NNScaleMap/training/results/leg2_ab/fill79514to79516
Universe           = vanilla
Executable         = /bin/bash
request_cpus       = 4
request_memory     = 12GB
environment        = "OMP_NUM_THREADS=$(request_cpus) PYTHONUNBUFFERED=1"
Output             = $(base)/logs/compare.out
Error              = $(base)/logs/compare.err
Log                = /tmp/condor-NNScaleMap-hjheng_leg2ab.log
Arguments          = "-c 'source /sphenix/user/hjheng/sPHENIXRepo/analysis/NNScaleMap/setup.sh && cd /sphenix/user/hjheng/sPHENIXRepo/analysis/NNScaleMap/training && python leg2_ab/compare.py $(base)'"
Queue
