# Hyperparameter scan, fill 79514-79516. Each line of trials.txt is one job: <trial> <train.py flags>,
# overriding the nominal card (hidden 48, layers 3, lr 2e-3, 800 epochs, seed 17, float32).
# Every trial trains stage 1 on the even half; hpo/score.py scores it on the odd half.
# Once, before the first submit (from training/, in the venv shell):
#   mkdir -p <base>/logs
#   python resample.py --halves --outdir <inputs> <kshort skim> <lam skim>
# Submit from training/hpo/:  condor_submit condor_hpo.job
base               = /sphenix/user/hjheng/sPHENIXRepo/analysis/NNScaleMap/training/results/hpo/fill79514to79516
inputs             = /sphenix/tg/tg01/hf/hjheng/HF-analysis/NNScaleMap/hpo/fill79514to79516/inputs
card               = /sphenix/user/hjheng/sPHENIXRepo/analysis/NNScaleMap/training/configs/fullsample_20261011_fill79514to79516.toml
kshort             = $(inputs)/skimmed_output_Kshort_reco_KFParticle_run79514_to_79516_cut_even.root
lam                = $(inputs)/skimmed_output_Lambda0_reco_KFParticle_run79514_to_79516_cut_even.root

Universe           = vanilla
Executable         = /sphenix/user/hjheng/sPHENIXRepo/analysis/NNScaleMap/training/run_trial.sh
transfer_executable = false
request_cpus       = 4
request_memory     = 8GB
environment        = "OMP_NUM_THREADS=$(request_cpus) PYTHONUNBUFFERED=1"

Output             = $(base)/logs/$(trial).out
Error              = $(base)/logs/$(trial).err
Log                = /tmp/condor-NNScaleMap-hjheng_hpo_$(Cluster).log
Arguments          = "$(card) $(base)/$(trial) $(kshort) $(lam) $(flags)"

Queue trial,flags from trials.txt
